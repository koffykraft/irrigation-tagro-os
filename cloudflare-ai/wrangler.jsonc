{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jain-irrigation-v5-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "vars": {
    "ENVIRONMENT": "staging",
    "BUILD": "co-design-environment-v1",
    "AI_MODEL": ""
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../app/environment-v1",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
