name = "tagro-irrigation-api"
main = "worker.js"
compatibility_date = "2026-08-11"

[vars]
APP_ORIGIN = "https://koffykraft.github.io"
AI_GATEWAY_ID = "default"
AI_MODEL = "anthropic/claude-sonnet-4-5"
WHATSAPP_GRAPH_VERSION = "SET_CURRENT_META_GRAPH_VERSION"

[[d1_databases]]
binding = "DB"
database_name = "tagro-irrigation"
database_id = "SET_D1_DATABASE_ID"

# Required secrets:
# CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN
# WHATSAPP_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_VERIFY_TOKEN