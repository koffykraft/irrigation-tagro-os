{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tagro.in/schemas/ai-adviser-response-v1.0.schema.json",
  "title": "TAGRO Irrigation Adviser Response v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "understanding", "next_question", "question_reason", "proposals"],
  "properties": {
    "message": {
      "type": "string",
      "description": "Plain-spoken conversational reply. No technical dump unless required by the current question."
    },
    "understanding": {
      "type": ["string", "null"],
      "description": "Short revisable reflection of what the adviser currently understands. Must not convert assumptions into facts."
    },
    "next_question": {
      "type": ["string", "null"],
      "description": "At most one consequential next question. Null when no question is needed."
    },
    "question_reason": {
      "type": ["string", "null"],
      "description": "Why the next question matters, in plain language."
    },
    "proposals": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "affected_ids", "assumptions", "unknowns", "checks_required", "intent", "reasoning", "consequences", "source_refs", "confidence"],
        "properties": {
          "kind": {
            "enum": ["geometry", "design", "product", "operating_plan", "human_access", "budget_tradeoff", "future_expansion"]
          },
          "summary": {"type": "string"},
          "affected_ids": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}},
          "checks_required": {"type": "array", "items": {"type": "string"}},
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "anchor_ids", "parameters"],
            "properties": {
              "operation": {
                "enum": [
                  "generate_laterals",
                  "generate_submains",
                  "place_devices",
                  "move_control_near",
                  "split_run",
                  "change_operating_groups",
                  "compare_products",
                  "compare_pipe_sizes",
                  "stage_installation",
                  "future_ready_route",
                  "review_only"
                ]
              },
              "anchor_ids": {"type": "array", "items": {"type": "string"}},
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "description": "Design intent only. Null/unknown fields are preferable to invented values. Final map/canvas coordinates are forbidden.",
                "required": ["spacing_m", "run_length_m", "count", "side", "direction_basis", "operating_groups", "pipe_size_mm", "device_category", "product_family", "stage", "notes"],
                "properties": {
                  "spacing_m": {"type": ["number", "null"], "description": "Requested/confirmed spacing only; null if not known."},
                  "run_length_m": {"type": ["number", "null"], "description": "Requested/confirmed intended run length only; null if not known."},
                  "count": {"type": ["integer", "null"], "description": "Requested/derived count only when grounded in supplied context; otherwise null."},
                  "side": {"enum": ["left", "right", "both", "unknown"]},
                  "direction_basis": {"enum": ["plants", "rows", "boundary", "submain", "path", "user_mark", "unknown"]},
                  "operating_groups": {"type": ["integer", "null"]},
                  "pipe_size_mm": {"type": ["number", "null"], "description": "Only a candidate/confirmed size, never a silently accepted design size."},
                  "device_category": {"type": ["string", "null"]},
                  "product_family": {"type": ["string", "null"]},
                  "stage": {"enum": ["current", "future", "phased", "unknown"]},
                  "notes": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          },
          "reasoning": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engineering", "manufacturer", "tagro_policy", "learned_observation", "human"],
            "properties": {
              "engineering": {"type": "array", "items": {"type": "string"}},
              "manufacturer": {"type": "array", "items": {"type": "string"}},
              "tagro_policy": {"type": "array", "items": {"type": "string"}},
              "learned_observation": {"type": "array", "items": {"type": "string"}},
              "human": {"type": "array", "items": {"type": "string"}}
            }
          },
          "consequences": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capital_cost", "operating_time", "manual_work", "energy", "convenience", "future_readiness", "quantified_notes"],
            "properties": {
              "capital_cost": {"enum": ["lower", "similar", "higher", "unknown"]},
              "operating_time": {"enum": ["shorter", "similar", "longer", "unknown"]},
              "manual_work": {"enum": ["less", "similar", "more", "unknown"]},
              "energy": {"enum": ["lower", "similar", "higher", "unknown"]},
              "convenience": {"enum": ["lower", "similar", "higher", "unknown"]},
              "future_readiness": {"enum": ["lower", "similar", "higher", "unknown"]},
              "quantified_notes": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Only numbers already supplied by deterministic engines or authoritative sources. Never invent costs, metres, flow, pressure or time."
              }
            }
          },
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
